# WebSocket Server Configuration
WS_HOST=0.0.0.0
WS_PORT=8765

# TLS (wss/https): set both to enable TLS on port 8765 (cert bind-mounted at /certs).
# 同时设置后端口切换为加密 wss/https，与明文 ws/http 互斥。
WS_SSL_CERT=/certs/server.pem
WS_SSL_KEY=/certs/server.key

# Heartbeat Configuration
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15

# Database Configuration
DB_ENGINE=sqlite
DB_NAME=websocket_server.db

# Logging
LOG_LEVEL=INFO

# JWT API Key Authentication (Multi-tenant isolation)
# JWT 签名密钥，用于验证 API Key 和实现多租户隔离
# 生产环境请使用强随机字符串
WS_JWT_SECRET=ws-platform-jwt-secret-2026

# 租户隔离严格模式
# false (默认): 兼容模式，允许 tenant_id 为 NULL 的历史数据被所有租户访问
# true: 严格模式，只返回当前租户的数据（需要先完成历史数据迁移）
WS_TENANT_STRICT=false
