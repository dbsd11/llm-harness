# Database Configuration
DB_ENGINE=sqlite
DB_NAME=agent_server.db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_TIMEOUT=30

# Server Configuration
GRADIO_PORT=8080
FLASK_PORT=5000
GRADIO_HOST=0.0.0.0
FLASK_HOST=0.0.0.0

# Authentication
AUTH_ENABLED=true

# Watchdog Configuration
WATCHDOG_CHECK_INTERVAL=10
WATCHDOG_DEFAULT_TIMEOUT=3600

# Sandbox Configuration
SANDBOX_TIMEOUT=300
SANDBOX_MAX_OUTPUT_SIZE=1048576

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(filename)s:%(lineno)d - %(levelname)s - %(message)s

# Admin Credentials (emergency backdoor login; leave blank to disable)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# LLM Configuration (DashScope / OpenAI-compatible)
DASHSCOPE_API_KEY=your-dashscope-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=true
LLM_TIMEOUT=120

# Human Agent (browser-direct WS, reuses execution-server protocol)
HUMAN_AGENT_DEFAULT_ID=human-1
HUMAN_AGENT_QUOTA=8
HUMAN_WS_PORT=8765
HUMAN_HEARTBEAT_INTERVAL=5

# Sandbox Configuration (execution agent server Docker containers)
SANDBOX_SSH_HOST=agent-socket-server.bdzz.com.cn
SANDBOX_SSH_USER=ubuntu
# SSH authentication: use password OR key (password takes precedence)
SANDBOX_SSH_PASSWORD=
SANDBOX_SSH_KEY_PATH=~/.ssh/id_rsa
SANDBOX_DOCKER_IMAGE=execution-agent-server:latest
SANDBOX_DEFAULT_QUOTA=4
SANDBOX_HEARTBEAT_INTERVAL=5
# Backend WS URL reachable from inside the sandbox container
SANDBOX_BACKEND_WS_URL=wss://agent-socket-server.bdzz.com.cn:8765

# Remote WebSocket Server Configuration
# API URL for querying execution servers and dispatching tasks (REST shares port 8765 with WS)
WS_SERVER_API_URL=https://agent-socket-server.bdzz.com.cn:8765
# WebSocket URL for Human Agent browser connections
WS_SERVER_WS_URL=wss://agent-socket-server.bdzz.com.cn:8765
